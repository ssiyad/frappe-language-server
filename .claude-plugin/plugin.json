{
  "name": "frappe-lsp",
  "version": "0.2.1",
  "description": "frappe-lsp for Claude Code: Frappe DocTypes, fields, hooks and templates as code intelligence, and frappe-lsp's checks after every edit inside a bench",
  "author": {
    "name": "Sabu Siyad",
    "email": "hello@ssiyad.com"
  },
  "homepage": "https://github.com/ssiyad/frappe-language-server",
  "repository": "https://github.com/ssiyad/frappe-language-server",
  "license": "GPL-3.0-only",
  "keywords": [
    "frappe",
    "erpnext",
    "lsp"
  ],
  "skills": [
    "./claude/skills/"
  ],
  "lspServers": {
    "frappe-lsp": {
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/frappe-lsp",
      "extensionToLanguage": {
        ".py": "python",
        ".js": "javascript",
        ".json": "json",
        ".html": "html"
      },
      "startupTimeout": 120000
    }
  }
}
